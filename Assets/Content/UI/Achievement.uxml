<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/UI/Styles/achievement-style.uss?fileID=7433441132597879392&amp;guid=f7041f123f321414980a0a28dbcaf391&amp;type=3#achievement-style"/>
    <ui:VisualElement name="achievement" class="achievement" style="flex-grow: 1; min-height: 100px; max-height: 100px; min-width: 400px; max-width: 400px; flex-direction: row; border-left-color: rgb(213, 213, 213); border-right-color: rgb(213, 213, 213); border-top-color: rgb(213, 213, 213); border-bottom-color: rgb(213, 213, 213); justify-content: flex-start; align-items: center; background-color: rgb(55, 55, 63); border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; padding-left: 10px; margin-bottom: 20px; margin-right: 30px; -unity-material: url(&quot;&quot;);">
        <ui:VisualElement name="icon" class="not-completed" style="border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; min-width: 80px; max-width: 80px; min-height: 80px; max-height: 80px; -unity-background-image-tint-color: rgb(255, 255, 255);"/>
        <ui:VisualElement name="text-container" style="flex-grow: 1; justify-content: flex-end; margin-left: 12.5px; margin-right: 15px;">
            <ui:Label text="&#1053;&#1072;&#1079;&#1074;&#1072;&#1085;&#1080;&#1077;" name="title" style="font-size: 26px; -unity-font-definition: url(&quot;project://database/Assets/Content/Fonts/Onest-Medium.ttf?fileID=12800000&amp;guid=fa73f5a94ced6614fa22a07e7d60523b&amp;type=3#Onest-Medium&quot;); color: rgb(255, 255, 255); min-height: 30px; max-height: 30px; -unity-text-align: middle-left; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; text-overflow: ellipsis; visibility: visible; overflow: hidden;"/>
            <ui:Label text="&#1054;&#1087;&#1080;&#1089;&#1072;&#1085;&#1080;&#1077;" name="description" enable-rich-text="true" style="font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/Content/Fonts/Onest-Light.ttf?fileID=12800000&amp;guid=3d0d95fec6a680e40b8db4d20bda7f7f&amp;type=3#Onest-Light&quot;); color: rgb(188, 188, 188); min-height: 54px; max-height: 54px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; white-space: normal; text-overflow: ellipsis; overflow: hidden; visibility: visible; -unity-text-align: upper-left;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
