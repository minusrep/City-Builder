.menu-button {
    min-height: 75px;
    max-height: 75px;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    -unity-font-definition: url("project://database/Assets/Content/Fonts/Onest-Bold.ttf?fileID=12800000&guid=739e3c8cb2824ed43b983e0f7077a4a1&type=3#Onest-Bold");
    font-size: 26px;
    min-width: 400px;
    max-width: 400px;
    -unity-font-style: normal;
    color: rgb(255, 255, 255);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(185, 185, 185);
    border-right-color: rgb(185, 185, 185);
    border-top-color: rgb(185, 185, 185);
    border-bottom-color: rgb(185, 185, 185);
    margin-top: 0;
    margin-bottom: 20px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    transition-duration: 0.05s;
    transition-timing-function: ease-out-bounce;
    transition-property: all;
    transition-delay: 0s;
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: center;
    background-image: none;
    background-color: rgb(55, 55, 63);
    letter-spacing: 5px;
}

.menu-button:hover {
    min-height: 75px;
    max-height: 75px;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    -unity-font-definition: url("project://database/Assets/Content/Fonts/Onest-Bold.ttf?fileID=12800000&guid=739e3c8cb2824ed43b983e0f7077a4a1&type=3#Onest-Bold");
    font-size: 26px;
    min-width: 400px;
    max-width: 400px;
    -unity-font-style: normal;
    background-color: rgb(255, 199, 49);
    color: rgb(36, 36, 41);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(255, 199, 49);
    border-right-color: rgb(255, 199, 49);
    border-top-color: rgb(255, 199, 49);
    border-bottom-color: rgb(255, 199, 49);
    margin-top: 0;
    margin-bottom: 20px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    transition-duration: 0.05s;
    transition-timing-function: ease-out-bounce;
    transition-property: all;
    transition-delay: 0s;
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: center;
    background-image: none;
    letter-spacing: 5px;
}

.menu-button:active {
    min-height: 75px;
    max-height: 75px;
    border-top-left-radius: 25px;
    border-top-right-radius: 25px;
    border-bottom-right-radius: 25px;
    border-bottom-left-radius: 25px;
    -unity-font-definition: url("project://database/Assets/Content/Fonts/Onest-Bold.ttf?fileID=12800000&guid=739e3c8cb2824ed43b983e0f7077a4a1&type=3#Onest-Bold");
    font-size: 26px;
    min-width: 395px;
    max-width: 395px;
    -unity-font-style: normal;
    background-color: rgb(255, 199, 49);
    color: rgb(36, 36, 41);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-left-color: rgb(238, 187, 50);
    border-right-color: rgb(238, 187, 50);
    border-top-color: rgb(238, 187, 50);
    border-bottom-color: rgb(238, 187, 50);
    margin-top: 0;
    margin-bottom: 20px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    transition-duration: 0.05s;
    transition-timing-function: ease-in-bounce;
    transition-property: all;
    transition-delay: 0s;
    -unity-background-scale-mode: scale-and-crop;
    background-position-x: center;
    background-image: none;
    letter-spacing: 0;
}
