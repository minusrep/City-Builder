.completed {
    flex-grow: 1;
    min-width: 80px;
    max-width: 80px;
    max-height: 80px;
    min-height: 80px;
    background-image: url("project://database/Assets/Content/Imports/Clean%20Vector%20Icons/T_24_diamond_.png?fileID=2800000&guid=c9f0cc0739579d541a08ac2c78d3e605&type=3#T_24_diamond_");
    background-size: 98% 98%;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 60px;
    border-top-right-radius: 60px;
    border-bottom-right-radius: 60px;
    border-bottom-left-radius: 60px;
    border-left-color: rgb(255, 170, 0);
    border-right-color: rgb(255, 170, 0);
    border-top-color: rgb(255, 170, 0);
    border-bottom-color: rgb(255, 170, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    transition-duration: 0.5s;
    transition-timing-function: ease-in-out-sine;
}

.not-completed {
    flex-grow: 1;
    min-width: 80px;
    max-width: 80px;
    max-height: 80px;
    min-height: 80px;
    background-image: url("project://database/Assets/Content/Imports/Clean%20Vector%20Icons/T_24_diamond_.png?fileID=2800000&guid=c9f0cc0739579d541a08ac2c78d3e605&type=3#T_24_diamond_");
    background-size: 98% 98%;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 60px;
    border-top-right-radius: 60px;
    border-bottom-right-radius: 60px;
    border-bottom-left-radius: 60px;
    border-left-color: rgb(172, 172, 172);
    border-right-color: rgb(172, 172, 172);
    border-top-color: rgb(172, 172, 172);
    border-bottom-color: rgb(172, 172, 172);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.achievement {
    flex-grow: 1;
    min-height: 100px;
    max-height: 100px;
    min-width: 400px;
    max-width: 400px;
    flex-direction: row;
    border-left-color: rgb(213, 213, 213);
    border-right-color: rgb(213, 213, 213);
    border-top-color: rgb(213, 213, 213);
    border-bottom-color: rgb(213, 213, 213);
    justify-content: flex-start;
    align-items: center;
    background-color: rgb(55, 55, 63);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    padding-left: 10px;
    margin-bottom: 20px;
    margin-right: 20px;
    translate: 430px 0;
    transition-duration: 0.6s;
    transition-property: translate;
}

.achievement.show {
    translate: 0 0;
}
