.construction-content {
    position: absolute;
    right: 24px;
    bottom: 24px;
    flex-direction: column;
    align-items: flex-end;
    width: auto;
    height: auto;
}

.construction-toggle-button {
    background-color: #2d2d2d;
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    padding: 4px 8px;
    border-radius: 8px;
    border-width: 1px;
    border-color: #ffffff20;
}

.construction-panel {
    width: 520px;
    min-height: 140px;
    margin-top: 8px;
    background-color: #141414e6;
    border-radius: 14px;
    padding: 12px;
    flex-direction: column;
}

.construction-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.construction-title {
    font-size: 14px;
    color: white;
    -unity-font-style: bold;
}

.construction-close-button {
    width: 28px;
    height: 28px;
    background-color: #3c3c3c;
    border-radius: 6px;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 0;
    border-width: 1px;
    border-color: #ffffff20;
}

.construction-scroll {
    flex-grow: 1;
    height: 96px;
}

.building-list {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: 100%;
}

.building-button {
    width: 88px;
    height: 88px;
    background-color: #2d2d2d;
    border-radius: 12px;
    border-width: 1px;
    border-color: #ffffff14;
    color: #dcdcdc;
    font-size: 11px;
    -unity-font-style: bold;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 6px;
}

.building-button--selected {
    background-color: #6e96ff59;
    border-color: #b4d2ff;
    color: white;
}

.building-button:disabled {
    background-color: #1e1e1e;
    color: #b4b4b480;
}